PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# Supabase / Neon: set DATABASE_SSL=true
DATABASE_URL=postgres://askus:askus@localhost:5432/askus
DATABASE_SSL=false

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
OTP_SECRET=change-me-too

# Mobile/email that is granted SUPER_ADMIN on startup
SUPER_ADMIN_IDENTIFIER=

# Cashfree (Solutions payments)
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
SOLUTIONS_WEB_URL=http://localhost:3005

# Cloudflare R2 (private bucket; needs a CORS rule allowing PUT/GET from the web origins)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional paid RC-data provider for vehicle lookup (Surepass rc-full format)
VEHICLE_API_URL=
VEHICLE_API_KEY=
