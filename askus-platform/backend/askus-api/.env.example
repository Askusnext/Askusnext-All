PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# Supabase / Neon: set DATABASE_SSL=true
DATABASE_URL=postgres://askus:askus@localhost:5432/askus
DATABASE_SSL=false

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
OTP_SECRET=change-me-too

# Comma-separated mobiles/emails that are granted SUPER_ADMIN on startup
SUPER_ADMIN_IDENTIFIER=

# Cashfree (Solutions payments)
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
SOLUTIONS_WEB_URL=http://localhost:3005

# Cloudflare R2 (private bucket; needs a CORS rule allowing PUT/GET from the web origins)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional paid RC-data provider for vehicle lookup (Surepass rc-full format)
VEHICLE_API_URL=
VEHICLE_API_KEY=

# Email OTP via Resend (https://resend.com). Without a verified domain, Resend only delivers
# to your own account email; verify askussolutions.in and set MAIL_FROM to an address on it.
RESEND_API_KEY=
MAIL_FROM=AskUs <no-reply@askussolutions.in>

# SMS OTP via MSG91 (OTP API v5). TEMPLATE_ID is the DLT-approved OTP template (uses ##OTP##).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Comma-separated mobiles/emails granted these roles on startup
ADMIN_IDENTIFIERS=
EMPLOYEE_IDENTIFIERS=
AGENT_IDENTIFIERS=

# Test mode: every login uses this 6-digit OTP (no SMS or email needed). Leave EMPTY in production.
# (Staff accounts are never opened by it in production.)
DUMMY_OTP_CODE=

# Calendar sync (Email & Calendar module). Leave a provider's pair empty to hide its "Connect" button.
# Register API_PUBLIC_URL + /api/calendar/oauth/callback as the redirect URI in each developer console.
# Google: Calendar API enabled, scope calendar.events.readonly.  Microsoft: delegated Calendars.Read.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Public base URL of this API, and of the web app the person is sent back to after consenting.
API_PUBLIC_URL=http://localhost:4000
SOLUTIONS_WEB_URL=http://localhost:3005
# Encrypts the stored calendar tokens (AES-256-GCM). Falls back to JWT_SECRET if empty.
CALENDAR_TOKEN_KEY=
# Only needed if an external scheduler calls POST /api/calendar/sync-all (header x-cron-key). The built-in 20-minute timer needs nothing.
CALENDAR_SYNC_KEY=

# Renewals: open an Insurance renewal ticket this many days before a finished policy expires (default 30).
RENEWAL_WINDOW_DAYS=30

# Insurance & loan leads
# A claimed lead with no update for this many minutes goes back to the pool (only while it is still "Assigned").
CLAIM_TIMEOUT_MINUTES=15
# Deadline to resolve a lead, in hours. Renewal leads (expiring policies) use the urgent one.
LEAD_SLA_HOURS=48
URGENT_SLA_HOURS=4
# Encrypts uploaded KYC/policy documents at rest (AES-256-GCM). Falls back to JWT_SECRET if empty. Do NOT lose or change it.
LEADS_DOC_KEY=
# Payment links (Razorpay Payment Links API). Leave empty to paste links by hand.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stage alerts and customer messages. Email uses RESEND_API_KEY above. A channel with no settings is skipped (and shown as skipped in the lead).
# SMS: MSG91 transactional flow whose DLT template has one variable, ##var1##.
MSG91_FLOW_ID=
# WhatsApp Cloud API: an approved template with one body variable.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
